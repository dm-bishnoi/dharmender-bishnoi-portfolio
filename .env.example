# OpenRouter API Configuration
# Copy this file to `.env` (which is gitignored) and fill in your real values.
# Get your API key at: https://openrouter.ai/keys

# Required: Your OpenRouter API key (starts with sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME_WITH_YOUR_OPENROUTER_KEY

# Optional: Default model identifier (any model on https://openrouter.ai/models)
# Examples:
#   openai/gpt-4o-mini          (cheap, general purpose)
#   anthropic/claude-3.5-sonnet (high quality)
#   google/gemini-2.0-flash-exp (fast, multimodal)
OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2:free

# Optional: App identifier sent as the OpenRouter referrer header (your site URL)
OPENROUTER_APP_URL=http://localhost:4200

# Optional: Human-readable app name sent as the X-Title header
OPENROUTER_APP_NAME=Dharmender Bishnoi Portfolio
